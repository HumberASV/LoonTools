# LoonENV >>>

########################################
# Checks if the global variables are set and valid
# Uses the REQUIRED_VARIABLES array to determine what should be set and if it should be a specific value
# Globals:
#  REQUIRED_VARIABLES
#  NOT_CHECKED
#  MISSING
#  INVALID
#  VALID
# Arguments:
#  none
# Outputs:
# modified REQUIRED_VARIABLES_STATUS with missing, valid, invalid status
# 
########################################
check_variables(){
    log "Checking required environment variables..."

    # If CycloneDDS is active, also verify its URI is configured
    local active_rmw
    active_rmw=$(printenv "RMW_IMPLEMENTATION" 2>/dev/null)
    if [[ "$active_rmw" == "rmw_cyclonedds_cpp" ]]; then
        REQUIRED_VARIABLES["CYCLONEDDS_URI"]="file:///opt/cyclonedds.xml"
        REQUIRED_VARIABLE_STATUS["CYCLONEDDS_URI"]="$NOT_CHECKED"
    fi

    for var in "${!REQUIRED_VARIABLES[@]}"; do
        log "Checking variable $BLUE $var $PRIMARY..."
        local expected_value="${REQUIRED_VARIABLES[$var]}"
        local actual_value=$(printenv "$var" 2>/dev/null)
        log "Expected value: $GREEN $expected_value $PRIMARY"

        if [[ "$expected_value" == "$actual_value" ]]; then
            log "Variable $GREEN $var $PRIMARY is valid."
            REQUIRED_VARIABLE_STATUS[$var]="$VALID"
        elif [[ -z "$actual_value" ]]; then
            log "Variable $RED $var $PRIMARY is missing."
            REQUIRED_VARIABLE_STATUS[$var]="$MISSING"
        else
            log "Variable $ORANGE $var $PRIMARY is invalid. Actual value: $RED $actual_value $PRIMARY"
            REQUIRED_VARIABLE_STATUS[$var]="$INVALID"
        fi
    done
}

########################################
# Checks APT packages for LoonE to function
# Uses the REQUIRED_APT_PACKAGES array to determine what should be installed
# Globals:
#   REQUIRED_APT_PACKAGES
# Arguments:
# none
# Outputs:
# modified REQUIRED_APT_PACKAGES with missing and invalid status
########################################
check_apt_packages(){
    log "Checking for required apt packages..."
    local missing_packages=()
    for pkg in "${!REQUIRED_APT_PACKAGES[@]}"; do
        log "Checking package $BLUE $pkg $PRIMARY..."
        if dpkg -s "$pkg" >/dev/null 2>&1; then
            log "Package $GREEN $pkg $PRIMARY is installed."
            REQUIRED_APT_PACKAGES["$pkg"]="$VALID"
        else
            log "Package $RED $pkg $PRIMARY is missing."
            REQUIRED_APT_PACKAGES["$pkg"]="$MISSING"
            missing_packages+=("$pkg")
        fi
    done
}

########################################
# Checks the $WORKSPACE_DIR for missing directories or files
# Uses the FILE_STRUCTURE_MAP to determine what should be there and if it is a file or directory
# Globals:
#   FILE_STRUCTURE_MAP
# Arguments:
# none
# Outputs:
# modified FILE_STRUCTURE_MAP with missing and invalid status
########################################
check_file_structure(){
    log "Checking file structure in $WORKSPACE_DIR..."
    for path in "${!CORRECT_FILE_STRUCTURE[@]}"; do
        local expected_type="${CORRECT_FILE_STRUCTURE[$path]}"
        if [[ ! -e "$path" ]]; then
            log "Path $RED $path $PRIMARY is missing."
            FILE_STRUCTURE_STATUS["$path"]="$MISSING"
        elif [[ "$expected_type" -eq "$DIRECTORY_TYPE" && ! -d "$path" ]]; then
            log "Path $ORANGE $path $PRIMARY is invalid. Expected a directory but found a file."
            FILE_STRUCTURE_STATUS["$path"]="$INVALID"
        elif [[ "$expected_type" -eq "$FILE_TYPE" && ! -f "$path" ]]; then
            log "Path $ORANGE $path $PRIMARY is invalid. Expected a file but found a directory."
            FILE_STRUCTURE_STATUS["$path"]="$INVALID"
        else
            log "Path $GREEN $path $PRIMARY is valid."
            FILE_STRUCTURE_STATUS["$path"]="$VALID"
        fi
    done
}

# <<< LoonEnv


# Diagnosis Functions >>>

########################################
# Runs every diagnosis layer and prints a report.
# Layers run from the outside in: system prerequisites first, then the ROS
# graph, then the hardware, so that the first failure printed is usually the
# root cause rather than a downstream symptom.
# Globals:
#  FAIL_COUNT, PASS_COUNT, WARN_COUNT, SKIP_COUNT
# Arguments:
#  none
# Outputs:
#  Prints results to stdout, failures to stderr
# Returns:
#  0 if no check failed, 1 otherwise
########################################
diagnose_problems(){
    echo "${BOLD}Loon-E Doctor - system health check${PRIMARY}"
    [[ "$VERBOSE" -ne 1 ]] && echo "(passing checks hidden, run with -v to show them)"
    echo

    # Layer 0 - System prerequisites
    echo "${BOLD}Environment Variables:${PRIMARY}"
    check_variables
    report_variables

    echo "${BOLD}File Structure:${PRIMARY}"
    check_file_structure
    report_file_structure

    echo "${BOLD}Commands:${PRIMARY}"
    check_commands
    report_commands

    echo "${BOLD}APT Packages:${PRIMARY}"
    check_apt_packages
    report_apt_packages
    check_ros_apt_packages

    echo "${BOLD}Python Packages:${PRIMARY}"
    check_pip_packages

    # Layer 1 - ROS 2 node liveness
    echo "${BOLD}ROS Nodes:${PRIMARY}"
    check_nodes_alive

    # Layer 2 - Topics
    echo "${BOLD}ROS Topics:${PRIMARY}"
    check_topics_present

    # Layer 3 - TF tree
    echo "${BOLD}TF Tree:${PRIMARY}"
    check_tf_chain

    # Layer 4/5 - Parameter consistency and control watchdogs
    echo "${BOLD}Parameter Consistency:${PRIMARY}"
    check_parameter_consistency

    # Layer 6 - Peripherals
    echo "${BOLD}ZED Camera:${PRIMARY}"
    check_zed_daemon_status
    check_mtu
    report_mtu

    echo "${BOLD}Hardware:${PRIMARY}"
    check_hardware

    print_diagnosis_summary
}

########################################
# Prints the tally of every check recorded this run
# Globals:
#  PASS_COUNT, FAIL_COUNT, WARN_COUNT, SKIP_COUNT
# Arguments:
#  none
# Outputs:
#  Prints the summary line
# Returns:
#  0 if no check failed, 1 otherwise
########################################
print_diagnosis_summary(){
    echo
    echo "${BOLD}Summary:${PRIMARY} ${GREEN}${PASS_COUNT} passed${PRIMARY}, ${RED}${FAIL_COUNT} failed${PRIMARY}, ${ORANGE}${WARN_COUNT} warnings${PRIMARY}, ${BLUE}${SKIP_COUNT} skipped${PRIMARY}"

    if [[ "$FAIL_COUNT" -gt 0 ]]; then
        error "$FAIL_COUNT check(s) failed - review the details above."
        return 1
    fi

    echo "${GREEN}${BOLD}All critical checks passed.${PRIMARY}"
    return 0
}

########################################
# Reports the outcome of check_variables.
# A wrong ROS_DOMAIN_ID or RMW_IMPLEMENTATION makes every node, topic and TF
# check fail at once, so these are reported as hard failures and printed
# first - they are the usual root cause of an apparently dead graph.
# Globals:
#  REQUIRED_VARIABLES, REQUIRED_VARIABLE_STATUS
# Arguments:
#  none
########################################
report_variables(){
    for var in "${!REQUIRED_VARIABLES[@]}"; do
        add_check_from_status "${REQUIRED_VARIABLE_STATUS[$var]}" \
            "env: $var" \
            "expected '${REQUIRED_VARIABLES[$var]}', got '$(printenv "$var" 2>/dev/null)'"
    done
}

########################################
# Reports the outcome of check_file_structure
# Globals:
#  CORRECT_FILE_STRUCTURE, FILE_STRUCTURE_STATUS
# Arguments:
#  none
########################################
report_file_structure(){
    for path in "${!CORRECT_FILE_STRUCTURE[@]}"; do
        local expected="directory"
        [[ "${CORRECT_FILE_STRUCTURE[$path]}" == "$FILE_TYPE" ]] && expected="file"
        add_check_from_status "${FILE_STRUCTURE_STATUS[$path]}" \
            "path: $path" \
            "expected a $expected"
    done
}

########################################
# Reports the outcome of check_commands
# Globals:
#  required_commands, optional_commands_list
# Arguments:
#  none
########################################
report_commands(){
    for cmd in "${required_commands_list[@]}"; do
        add_check_from_status "${required_commands[$cmd]}" "cmd: $cmd"
    done
    # Optional tooling degrades to a warning - i2cdetect and adb are only
    # meaningful on the SBC, colcon only inside the build container
    for cmd in "${optional_commands_list[@]}"; do
        add_check_from_status "${required_commands[$cmd]}" "cmd: $cmd" "" "WARN"
    done
}

########################################
# Reports the outcome of check_apt_packages, including the Jetson-only
# packages which are skipped rather than failed on a dev workstation
# Globals:
#  required_apt_packages_list, jetson_apt_packages_list, REQUIRED_APT_PACKAGES
# Arguments:
#  none
########################################
report_apt_packages(){
    for pkg in "${required_apt_packages_list[@]}"; do
        add_check_from_status "${REQUIRED_APT_PACKAGES[$pkg]}" "apt: $pkg"
    done

    for pkg in "${jetson_apt_packages_list[@]}"; do
        if ! is_jetson; then
            add_check SKIP "apt: $pkg" "Jetson only, not L4T hardware"
        else
            add_check_from_status "${REQUIRED_APT_PACKAGES[$pkg]}" "apt: $pkg"
        fi
    done
}

########################################
# Checks the ROS 2 runtime packages the Loon-E stack depends on.
# Skipped wholesale when ROS is not installed, since on the Jetson host the
# entire ROS stack lives inside the container.
# Globals:
#  ros_apt_packages_list, ros_legacy_apt_packages_list
# Arguments:
#  none
########################################
check_ros_apt_packages(){
    if ! ros_available; then
        add_check SKIP "apt: ROS 2 runtime packages" "no ROS 2 install here, expected inside the container"
        return 0
    fi

    for pkg in "${ros_apt_packages_list[@]}"; do
        log "Checking ROS package $BLUE $pkg $PRIMARY..."
        if dpkg -s "$pkg" >/dev/null 2>&1; then
            add_check PASS "apt: $pkg"
        else
            add_check FAIL "apt: $pkg" "not installed"
        fi
    done

    for pkg in "${ros_legacy_apt_packages_list[@]}"; do
        if dpkg -s "$pkg" >/dev/null 2>&1; then
            add_check PASS "apt: $pkg" "legacy, superseded by nav2"
        else
            add_check SKIP "apt: $pkg" "legacy, no longer required"
        fi
    done
}

########################################
# Checks that the Python modules the stack imports are importable.
# Importing is the check that matters rather than asking pip, because the
# node fails on ImportError regardless of what pip's metadata claims.
# Globals:
#  required_pip_packages_list
# Arguments:
#  none
########################################
check_pip_packages(){
    log "Checking for required Python modules..."

    local python_bin
    python_bin=$(command -v python3 || true)
    if [[ -z "$python_bin" ]]; then
        add_check FAIL "python3" "not on PATH, cannot check Python modules"
        return 0
    fi

    for entry in "${required_pip_packages_list[@]}"; do
        local module="${entry%%:*}"
        local pkg="${entry##*:}"
        log "Checking module $BLUE $module $PRIMARY..."
        if "$python_bin" -c "import $module" >/dev/null 2>&1; then
            add_check PASS "pip: $pkg ($module)"
        else
            add_check FAIL "pip: $pkg ($module)" "import failed, try 'pip install $pkg'"
        fi
    done
}

########################################
# Interates over $REQUIRED_COMMANDS to determine any missing dependencies
# Globals:
# $REQUIRED_COMMANDS
# NOT_CHECKED
# MISSING
# VALID
# Arguments:
#  none
# Outputs:
#  modified $REQUIRED_COMMANDS with missing and valid status
########################################
check_commands(){
    log "Checking for required commands..."
    local missing_commands=()
    for cmd in "${!required_commands[@]}"; do
        log "Checking command $BLUE $cmd $PRIMARY..."
        if command -v "$cmd" >/dev/null 2>&1; then
            log "Command $GREEN $cmd $PRIMARY is available."
            required_commands["$cmd"]="$VALID"
        else
            log "Command $RED $cmd $PRIMARY is missing."
            required_commands["$cmd"]="$MISSING"
            missing_commands+=("$cmd")
        fi
    done
}

########################################
# Layer 1 - Checks that the expected nodes are live on the ROS graph.
# Globals:
#  critical_nodes_list, OPTIONAL_NODES
# Arguments:
#  none
# Outputs:
#  One check per expected node
########################################
check_nodes_alive(){
    if ! ros_available; then
        add_check SKIP "ROS node liveness" "ros2 not on PATH, is the workspace sourced?"
        return 0
    fi

    log "Listing live ROS nodes..."
    local node_list
    node_list=$(timeout 10 ros2 node list 2>/dev/null || true)

    if [[ -z "$node_list" ]]; then
        add_check FAIL "ROS graph" "no nodes visible - nothing is running, or ROS_DOMAIN_ID/RMW_IMPLEMENTATION disagree with the stack"
        return 0
    fi

    for node in "${critical_nodes_list[@]}"; do
        if node_is_alive "$node" "$node_list"; then
            add_check PASS "node: $node"
        else
            add_check FAIL "node: $node" "not found on the graph"
        fi
    done

    for node in "${!OPTIONAL_NODES[@]}"; do
        if node_is_alive "$node" "$node_list"; then
            add_check PASS "node: $node"
        else
            add_check WARN "node: $node" "${OPTIONAL_NODES[$node]}"
        fi
    done
}

########################################
# Determines whether a node name appears in a `ros2 node list` listing.
# Matches on the trailing path segment so that a namespaced node such as
# /zedx/zed_node satisfies a check for zed_node, without a bare substring
# match letting an unrelated node with a similar name pass.
# Globals:
#  none
# Arguments:
#  $1 - node name to look for
#  $2 - newline separated `ros2 node list` output
# Returns:
#  0 if the node is live, 1 otherwise
########################################
node_is_alive(){
    local wanted="$1"
    local listing="$2"
    local line

    while IFS= read -r line; do
        [[ -z "$line" ]] && continue
        [[ "${line##*/}" == "$wanted" ]] && return 0
    done <<< "$listing"

    return 1
}

########################################
# Layer 2 - Checks the topic chain exists and carries the expected types.
# A topic that exists with the wrong type is a warning rather than a
# failure: it usually means a remap is stale rather than the node being dead.
# Globals:
#  TOPIC_CHAIN
# Arguments:
#  none
# Outputs:
#  One check per expected topic
########################################
check_topics_present(){
    if ! ros_available; then
        add_check SKIP "ROS topics" "ros2 not on PATH, is the workspace sourced?"
        return 0
    fi

    log "Listing ROS topics..."
    # `ros2 topic list -t` prints "/topic [pkg/msg/Type]"
    local topic_list
    topic_list=$(timeout 10 ros2 topic list -t 2>/dev/null || true)

    if [[ -z "$topic_list" ]]; then
        add_check FAIL "ROS topics" "no topics visible on the graph"
        return 0
    fi

    for topic in "${!TOPIC_CHAIN[@]}"; do
        local expected="${TOPIC_CHAIN[$topic]}"
        local actual
        actual=$(topic_type "$topic" "$topic_list")

        if [[ -z "$actual" ]]; then
            add_check FAIL "topic: $topic" "not found on the graph"
        elif [[ "$actual" == "$expected" ]]; then
            add_check PASS "topic: $topic (${expected##*/})"
        else
            add_check WARN "topic: $topic" "expected $expected, got $actual"
        fi
    done
}

########################################
# Extracts the message type of a topic from `ros2 topic list -t` output
# Globals:
#  none
# Arguments:
#  $1 - topic name
#  $2 - newline separated `ros2 topic list -t` output
# Outputs:
#  The message type, or nothing if the topic is absent
########################################
topic_type(){
    local wanted="$1"
    local listing="$2"
    local line

    while IFS= read -r line; do
        [[ -z "$line" ]] && continue
        local name="${line%% *}"
        if [[ "$name" == "$wanted" ]]; then
            # Strip everything up to the opening bracket, then the closing one
            local type="${line#*[}"
            echo "${type%]*}"
            return 0
        fi
    done <<< "$listing"

    return 0
}

########################################
# Layer 3 - Checks that each transform in the chain resolves.
# tf2_echo runs until interrupted, so it is bounded by timeout and judged on
# whether it managed to print a transform before being killed.
# Globals:
#  tf_chain_list, TF_LOOKUP_TIMEOUT
# Arguments:
#  none
# Outputs:
#  One check per parent/child pair
########################################
check_tf_chain(){
    if ! ros_available; then
        add_check SKIP "TF tree" "ros2 not on PATH, is the workspace sourced?"
        return 0
    fi

    for pair in "${tf_chain_list[@]}"; do
        local parent="${pair%%:*}"
        local child="${pair##*:}"
        log "Looking up transform $BLUE $parent -> $child $PRIMARY..."

        local output
        output=$(timeout "$TF_LOOKUP_TIMEOUT" ros2 run tf2_ros tf2_echo "$parent" "$child" 2>&1 || true)

        # tf2_echo prints a Translation block once the lookup succeeds and
        # otherwise repeats a lookup failure message until it is killed
        if [[ "$output" == *"Translation"* ]]; then
            add_check PASS "tf: $parent -> $child"
        elif [[ "$output" == *"does not exist"* || "$output" == *"Invalid frame"* ]]; then
            add_check FAIL "tf: $parent -> $child" "frame does not exist"
        else
            add_check FAIL "tf: $parent -> $child" "no transform after ${TF_LOOKUP_TIMEOUT}s"
        fi
    done
}

########################################
# Layer 4/5 - Checks that paired parameters agree across nodes, which is
# also the control loop watchdog check: cmd_timeout is the dead-man switch,
# and a mismatch between the mixer and the driver means the boat keeps
# driving for longer than the mixer believes it will.
# Globals:
#  CONSISTENT_PARAMS
# Arguments:
#  none
# Outputs:
#  One check per parameter pair
########################################
check_parameter_consistency(){
    if ! ros_available; then
        add_check SKIP "parameter consistency" "ros2 not on PATH, is the workspace sourced?"
        return 0
    fi

    for left in "${!CONSISTENT_PARAMS[@]}"; do
        local right="${CONSISTENT_PARAMS[$left]}"
        local node_a="${left%%.*}"  param_a="${left##*.}"
        local node_b="${right%%.*}" param_b="${right##*.}"
        local label="param: ${left} == ${right}"

        local val_a val_b
        val_a=$(get_ros_param "$node_a" "$param_a")
        val_b=$(get_ros_param "$node_b" "$param_b")

        if [[ -z "$val_a" && -z "$val_b" ]]; then
            add_check SKIP "$label" "neither node is running"
        elif [[ -z "$val_a" ]]; then
            add_check WARN "$label" "cannot read ${left}"
        elif [[ -z "$val_b" ]]; then
            add_check WARN "$label" "cannot read ${right}"
        elif [[ "$val_a" == "$val_b" ]]; then
            add_check PASS "$label" "$val_a"
        else
            add_check FAIL "$label" "mismatch: $val_a vs $val_b"
        fi
    done
}

########################################
# Reads a single parameter from a live node.
# Globals:
#  none
# Arguments:
#  $1 - node name (without leading slash)
#  $2 - parameter name
# Outputs:
#  The parameter value, or nothing if the node or parameter is unavailable
########################################
get_ros_param(){
    local node="$1"
    local param="$2"
    local output

    # `ros2 param get` prints e.g. "Double value is: 0.5"
    output=$(timeout 5 ros2 param get "/$node" "$param" 2>/dev/null || true)
    [[ "$output" != *"value is:"* ]] && return 0

    local value="${output##*value is: }"
    echo "${value%%$'\n'*}"
}

########################################
# Layer 6 - Checks the I2C bus and the PCA9685 PWM driver behind the
# thrusters and rudder. Only meaningful on the SBC, so it is skipped rather
# than failed when the i2c tooling is absent.
# Globals:
#  I2C_BUS, PCA9685_ADDRESS
# Arguments:
#  none
# Outputs:
#  One check for the bus, one for the PCA9685
########################################
check_hardware(){
    if ! command -v i2cdetect >/dev/null 2>&1; then
        add_check SKIP "i2c bus $I2C_BUS" "i2cdetect not available, expected on the SBC only"
        add_check SKIP "PCA9685 at 0x$PCA9685_ADDRESS" "no i2c tooling"
        return 0
    fi

    log "Scanning i2c bus $BLUE $I2C_BUS $PRIMARY..."
    local scan
    if ! scan=$(timeout 10 i2cdetect -y "$I2C_BUS" 2>&1); then
        add_check FAIL "i2c bus $I2C_BUS" "bus not accessible: ${scan}"
        add_check SKIP "PCA9685 at 0x$PCA9685_ADDRESS" "i2c bus unavailable"
        return 0
    fi
    add_check PASS "i2c bus $I2C_BUS"

    # Read the cell for the address rather than grepping the whole dump: the
    # row labels themselves contain "40", so a substring match would report
    # the PCA9685 as present on an empty bus
    local cell
    cell=$(i2c_address_cell "$PCA9685_ADDRESS" "$scan")

    case "$cell" in
        "$PCA9685_ADDRESS")
            add_check PASS "PCA9685 at 0x$PCA9685_ADDRESS" ;;
        "UU")
            add_check WARN "PCA9685 at 0x$PCA9685_ADDRESS" "address is busy, a kernel driver already holds it" ;;
        *)
            add_check FAIL "PCA9685 at 0x$PCA9685_ADDRESS" "not detected on i2c bus $I2C_BUS" ;;
    esac
}

########################################
# Extracts the cell for one address out of an i2cdetect dump.
# i2cdetect lays out 16 addresses per row, labelled by the high nibble, so
# the cell for 0xNM is field M+2 of the row labelled "N0:" (field 1 is the
# row label itself).
# Globals:
#  none
# Arguments:
#  $1 - two digit hex address, e.g. "40"
#  $2 - i2cdetect output
# Outputs:
#  The cell contents: the address if present, "--" if absent, "UU" if busy
########################################
i2c_address_cell(){
    local address="$1"
    local scan="$2"
    local row="${address:0:1}0:"
    local column=$((16#${address:1:1} + 2))

    echo "$scan" | awk -v row="$row" -v col="$column" '$1 == row {print $col}'
}

########################################
# Checks MTU on physical interfaces and populates MTU_ISSUES for diagnose_problems output
# Globals:
#  MTU_ISSUES
# Arguments:
#  none
########################################
check_mtu(){
    log "Checking MTU on network interfaces..."
    local required_mtu=9000
    MTU_ISSUES=()
    while IFS= read -r iface; do
        local mtu
        mtu=$(ip link show "$iface" 2>/dev/null | grep -oP 'mtu \K[0-9]+')
        [[ -n "$mtu" && "$mtu" -lt "$required_mtu" ]] && MTU_ISSUES+=("$iface (MTU: $mtu, required: $required_mtu)")
    done < <(ip -o link show | awk '{print $2}' | tr -d ':' | grep -vE '^(lo|docker|br-|veth|tailscale)' || true)
}

########################################
# Reports the outcome of check_mtu.
# The ZED X streams over GMSL and needs jumbo frames, so an interface below
# 9000 shows up as dropped frames rather than an obvious error.
# Globals:
#  MTU_ISSUES
# Arguments:
#  none
########################################
report_mtu(){
    if [[ "${#MTU_ISSUES[@]}" -eq 0 ]]; then
        add_check PASS "network: all physical interfaces at MTU >= 9000"
        return 0
    fi

    for issue in "${MTU_ISSUES[@]}"; do
        add_check WARN "network: $issue" "run 'sudo configMTU' to enable jumbo frames"
    done
}

# <<< Diagnosis Functions

#######################################
# Detects if in a container environment
# Globals:
# Arguments:
#   None
# Returns:
# 0 if in container, 1 if not
#######################################
in_container() {
    if [[ $(printenv "CONTAINER" 2>/dev/null) == "true" ]]; then
        return 0
    fi
    if [ -f "/.dockerenv" ]; then
        return 0
    fi
    if grep -qE '/docker|/lxc|/kubepods' /proc/1/cgroup 2>/dev/null; then
        return 0
    fi
    return 1
}

################################
# Attempts to build colcon workspace
# Globals:
# Arguments:
#   service - loone or zed
# Outputs:
# Asks before refreshing the rosdep database (unprivileged - rosdep update
# only touches ~/.ros/rosdep, it never needed sudo), then runs the
# privileged apt/rosdep-install/colcon build sequence for the service
################################
build_colcon(){
    local service="${1:-loone}"
    if [[ "$service" != "loone" && "$service" != "zed" ]]; then
        error "Unknown service: $BLUE $service $PRIMARY. Valid options are 'loone' or 'zed'."
        exit 1
    fi

    if ! in_container; then
        warn "Not running inside a container."
        if confirm "Colcon build should be run inside the container environment. Do you want to continue?"; then
            log "Continuing with colcon build outside container..."
        else
            error "Colcon build should be run inside the container environment. Please run this command after entering the container."
            exit 1
        fi
    fi

    if confirm "Run 'rosdep update' to refresh the local rosdep database before building?"; then
        run 'source /opt/ros/humble/setup.bash && rosdep update'
    else
        log "Skipping rosdep update; using existing rosdep cache."
    fi

    echo "Running build commands for $service service..."
    local extra_colcon_args=""
    [[ "$service" == "zed" ]] && extra_colcon_args="--packages-skip zed_debug"

    run 'sudo /bin/bash -c "source /opt/ros/humble/setup.bash && \
        apt-get update && \
        rosdep install --from-paths src --ignore-src -r -y && \
        colcon build --parallel-workers 4 --symlink-install \
            --event-handlers console_direct+ \
            --base-paths src \
            --cmake-clean-cache \
            --cmake-args \
            -DCMAKE_BUILD_TYPE=Release \
            -DZED_SDK_ROOT=/usr/local/zed \
            -DCMAKE_LIBRARY_PATH=/usr/local/cuda/lib64/stubs \
            -DCMAKE_CXX_FLAGS=\"-Wl,--allow-shlib-undefined\" \
            --no-warn-unused-cli '"$extra_colcon_args"'"'
}

# MAIN FUNCTIONS >>>

usage() {
    cat << EOF
Usage: $(basename "$0") [options]

Options:
    -d, --wtf, --doctor   Run diagnostics to check for common issues.
                          Exits non-zero if any check fails.
    -mtu, --mtu           Check network MTU only
    --restart-zed         Attempt to bring the ZED daemon back online
    -c, --colcon          Build the colcon workspace (should be run inside container)
    -h, --help      Show help
    -v, --verbose   Enable verbose mode, shows passing checks too
    --dry-run       Do not execute changes
    --version       print version
EOF
}

#######################################
# Parses arguments for script running
# Globals:
# VERBOSE
# DRY_RUN
# LOON_TOOLS_VERSION
# Arguments:
#   $@ Arguments to parse
# Returns:
# Nothing
#######################################
parse_runtime_arguments() {
    while [[ $# -gt 0 ]]; do
        case "$1" in
            -v|--verbose)
                VERBOSE=1
                log Yapping mode activiated!
                shift
                ;;
            --dry-run)
                DRY_RUN=1
                log All bark no bite mode running!
                shift
                ;;
            -h|--help)
                usage
                exit 0
                ;;
            --version)
                echo v"$LOON_TOOLS_VERSION"
                exit 0
                ;;
            *)
                log "Found Unknown run time arge $1, probbably not an arg for runtime"
                shift
                ;;
        esac
    done
}

#######################################
# Parses arguments related to script function
# Globals:
# NONE
# Arguments:
#   $@ Arguments to parse
# Returns:
# Nothing
#######################################
parse_functional_arguments(){
    while [[ $# -gt 0 ]]; do
        case "$1" in
            -d|--wtf|--doctor)
            # Exit non-zero when a check failed so the doctor is usable from
            # CI and from other scripts, not just by eye
            diagnose_problems || exit 1
            exit 0
            ;;
            --restart-zed)
            check_zed_daemon || { error "Zed Daemon could not be brought online."; exit 1; }
            exit 0
            ;;
            -mtu|--mtu)
            check_mtu
            echo "${BOLD}Network MTU (required: 9000):${PRIMARY}"
            if [[ ${#MTU_ISSUES[@]} -eq 0 ]]; then
                echo "  ${GREEN}✓ All physical interfaces >= 9000${PRIMARY}"
            else
                for issue in "${MTU_ISSUES[@]}"; do
                    echo "  ${RED}✗ $issue${PRIMARY}"
                done
                echo "  Run ${BOLD}sudo configMTU${PRIMARY} to enable Jumbo Frames."
            fi
            exit 0
            ;;
            -c|--colcon)
            build_colcon "$2"
            exit 0
            ;;
            -v|--verbose|--dry-run)
            # Already consumed by parse_runtime_arguments; skipped here so a
            # runtime flag in any position does not look like a function
            shift
            ;;
            *)
            error "Unknown function $1"
            exit 1;
            ;;
        esac
    done
}


# >>> MAIN <<< #
main () {
    parse_runtime_arguments "$@"

    log "Checking for existing installation lock..."

    # Check for existing installation lock
    # Put here to run immediately before any significant operations to save time
    if [[ -f "$LOCKFILE" ]]; then
        echo "Another process is already in progress. Please wait for it to finish." >&2
        exit 1
    fi
    log "No existing installation lock found. Creating installation lock..."

    # Prevent Concurrency Issues
    create_lock

    # Set trap to clean up lock file on exit
    trap cleanup EXIT

    # Code for processes go after here
    # Pass every argument through: parse_functional_arguments skips the
    # runtime flags itself, which works regardless of where they appear.
    # Slicing by a count of leading runtime flags used to drop the function
    # flag entirely when a runtime flag followed it (e.g. --doctor -v).
    parse_functional_arguments "$@"
}


main "$@"