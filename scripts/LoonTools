# <<< Utility Functions




##################################
# Prints the status of a map with color coded symbols
# Globals:
# NOT_CHECKED
# MISSING
# INVALID
# VALID
# BLUE
# RED
# ORANGE
# GREEN
# PRIMARY
# Arguments:
#   $1 - the name of the associative array to print (passed by name)
# Returns:
# Nothing, prints the status of each key in the map to stdout
##################################
print_map_status() {
    declare -A status_symbols=(
        [$NOT_CHECKED]="${BLUE}?${PRIMARY}"
        [$MISSING]="${RED}✗${PRIMARY}"
        [$INVALID]="${ORANGE}!${PRIMARY}"
        [$VALID]="${GREEN}✓${PRIMARY}"
    )

    local -n map="$1"
    for key in "${!map[@]}"; do
        printf "%-30s %s\n" "$key" "${status_symbols[${map[$key]}]}"
    done
}

# Check Result Accumulator >>>

# Running tallies for the diagnosis summary, populated by add_check
PASS_COUNT=0
FAIL_COUNT=0
WARN_COUNT=0
SKIP_COUNT=0

##################################
# Records the outcome of a single check and prints it.
# Passing checks are only printed in verbose mode so that a healthy system
# produces a short report and anything printed is worth reading.
# Globals:
#  PASS_COUNT, FAIL_COUNT, WARN_COUNT, SKIP_COUNT
#  VERBOSE
#  GREEN, RED, ORANGE, BLUE, PRIMARY
# Arguments:
#   $1 - status: PASS | FAIL | WARN | SKIP
#   $2 - check name
#   $3 - optional detail shown after the name
# Outputs:
#  Prints the check line to stdout (FAIL goes to stderr)
##################################
add_check() {
    local status="$1"
    local name="$2"
    local detail="${3:-}"
    local symbol colour

    case "$status" in
        PASS) symbol="✓"; colour="$GREEN";  PASS_COUNT=$((PASS_COUNT + 1)) ;;
        FAIL) symbol="✗"; colour="$RED";    FAIL_COUNT=$((FAIL_COUNT + 1)) ;;
        WARN) symbol="!"; colour="$ORANGE"; WARN_COUNT=$((WARN_COUNT + 1)) ;;
        SKIP) symbol="-"; colour="$BLUE";   SKIP_COUNT=$((SKIP_COUNT + 1)) ;;
        *)    symbol="?"; colour="$BLUE" ;;
    esac

    # Quiet runs only surface things that need attention
    if [[ "$status" == "PASS" && "$VERBOSE" -ne 1 ]]; then
        return 0
    fi

    local line="  ${colour}${symbol}${PRIMARY} ${name}"
    [[ -n "$detail" ]] && line="${line} ${colour}(${detail})${PRIMARY}"

    if [[ "$status" == "FAIL" ]]; then
        echo "$line" >&2
    else
        echo "$line"
    fi
}

##################################
# Translates one of the legacy MISSING/INVALID/VALID/NOT_CHECKED status map
# values into an add_check call, so the older checks feed the same summary.
# Globals:
#  MISSING, INVALID, VALID
# Arguments:
#   $1 - the legacy status value
#   $2 - check name
#   $3 - detail to show when the status is INVALID
#   $4 - severity to use when not VALID: FAIL (default) | WARN | SKIP
##################################
add_check_from_status() {
    local status="$1"
    local name="$2"
    local detail="${3:-}"
    local severity="${4:-FAIL}"

    # String comparison, not -eq: [[ -eq ]] evaluates arithmetically, which
    # silently coerces an unset status to 0 and reports it as MISSING
    if [[ "$status" == "$VALID" ]]; then
        add_check PASS "$name"
    elif [[ "$status" == "$MISSING" ]]; then
        add_check "$severity" "$name" "missing"
    elif [[ "$status" == "$INVALID" ]]; then
        add_check "$severity" "$name" "$detail"
    else
        add_check SKIP "$name" "not checked"
    fi
}

