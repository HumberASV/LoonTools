# Zed Utility Functions >>>

#######################################
# Parses zed version
# Globals:
# Arguments:
#   None
# Returns:
# x.x.x version detected or nothing
#######################################
parse_zed_version(){
    local ZED_VERSION=$(sudo cat /usr/local/zed/zed-config-version.cmake | grep "set(PACKAGE_VERSION \"" | sed -E 's/set\(PACKAGE_VERSION "(.*)"\)/\1/')
    echo "$ZED_VERSION"
}

#######################################
# Determines Zed_x_daemon service status 
# Globals:
# Arguments:
#   None
# Returns:
# Gets the status of offline, restarting, online 
#######################################
get_zed_daemon_status(){
    # if we are in a container we don't have systemctl so we have to use the command directly
    if in_container; then
        local output=$(sudo /usr/local/zed/zed_x_daemon --status 2>&1 || echo "offline")
        if [[ "$output" == *"online"* ]]; then
            echo "online"
        elif [[ "$output" == *"restarting"* ]]; then
            echo "restarting"
        else
            echo "offline"
        fi
    else
        local status=$(systemctl is-active zed_x_daemon 2>/dev/null || echo "offline")
        if [[ "$status" == "active" ]]; then
            echo "online"
        elif [[ "$status" == "activating" ]]; then
            echo "restarting"
        else
            echo "offline"
        fi
    fi
}

#######################################
# attempts to restart zed_x_daemon service 
# Globals:
# Arguments:
#   None
# Returns:
# Nothing
#######################################
restart_zed_daemon(){
    log "Attempting to restart Zed Daemon..."
    # if we are in a container we don't have systemctl so we have to use the command directly
    if in_container; then
        run "sudo /usr/local/zed/zed_x_daemon --restart"
        return
    else
        run "sudo systemctl restart zed_x_daemon"
    fi
}


###################################
# Reports the zed daemon status without touching it.
# The diagnosis path uses this rather than check_zed_daemon: a doctor should
# describe the system, not restart services underneath the operator while
# they are trying to work out what is wrong.
# Globals:
# Arguments:
#   None
# Outputs:
#  One check for the daemon state
###################################
check_zed_daemon_status(){
    if ! require_zed_driver; then
        add_check SKIP "zed daemon" "ZED driver not installed here"
        return 0
    fi

    local status
    status=$(get_zed_daemon_status)
    case "$status" in
        online)
            add_check PASS "zed daemon" ;;
        restarting)
            add_check WARN "zed daemon" "still starting up" ;;
        *)
            add_check FAIL "zed daemon" "$status - run 'LoonTools --restart-zed' to recover" ;;
    esac
}

###################################
# Checks if zed daemon is online and attempts to restart if not
# Globals:
# Arguments:
#   None
# Returns:
# 0 if online or successfully restarted, 1 if failed to restart
###################################
check_zed_daemon(){
    local status=$(get_zed_daemon_status)
    if [[ "$status" == "online" ]]; then
        log "Zed Daemon is online."
        return 0
    fi

    warn "Zed Daemon is not online. Attempting to restart..."
    for i in {1..3}; do
        log "Restart attempt $i..."
        restart_zed_daemon
        sleep 5 # Wait for a few seconds to allow the service to restart
        status=$(get_zed_daemon_status)
        if [[ "$status" == "online" ]]; then
            log "Zed Daemon restarted successfully and is now online."
            return 0
        fi
        error "Failed to restart Zed Daemon. Current status: $status"
    done

    # Fall through means all three attempts failed - report it, rather than
    # returning the exit status of `continue` and looking like a success
    return 1
}

