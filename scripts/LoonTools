################################
# Initializes a status map with a given status for a list of keys
# Globals:
# NONE
# Arguments:
#   $1 - the status to set for each key
#   $2 - the name of the associative array to initialize (passed by name)
#   $3... - the list of keys to initialize in the map
# Returns:
# Nothing, modifies the associative array passed by name
###############################
init_status_map() {
    local status="$1"
    shift

    declare -n map="$1"
    shift

    for key in "$@"; do
        map["$key"]="$status"
    done
}

#######################################
# Dictionary to check for in environment
# Globals:
# USER
# Format:
#   
# Dictionary value types:
#   string, boolean | null , boolean | null
# null means data not set because it has not been checked.
#######################################
declare -A REQUIRED_VARIABLES
REQUIRED_VARIABLES=(
    ["RMW_IMPLEMENTATION"]="rmw_fastrtps_cpp"
    ["ROS_DOMAIN_ID"]="0"
    ["ROS_LOCALHOST_ONLY"]="0"
    ["ZED_SDK_VERSION"]="5.2.3"
    ["L4T_VERSION"]="36.4.2"
    ["ROS_DISTRO"]="humble"
    ["XAUTHORITY"]="/home/$USER/.Xauthority"
    ["DISPLAY"]=":0"
    ["COLCON_PREFIX_PATH"]=null
)

#######################################
# Dictionary to check for in file structure
# Globals:
#  WORKSPACE_DIR
#  DIRECTORY_TYPE
#  FILE_TYPE
# Format:
#   "path/to/file_or_directory"=type
# Dictionary value types:
#   "$FILE_TYPE" | "$DIRECTORY_TYPE"
#######################################
declare -A CORRECT_FILE_STRUCTURE
CORRECT_FILE_STRUCTURE=(
    ["$WORKSPACE_DIR"]="$DIRECTORY_TYPE"
    ["$WORKSPACE_DIR/zed_ws"]="$DIRECTORY_TYPE"
    ["$WORKSPACE_DIR/zed_ws/src"]="$DIRECTORY_TYPE"
    ["$WORKSPACE_DIR/loon_ws"]="$DIRECTORY_TYPE"
    ["$WORKSPACE_DIR/loon_ws/src"]="$DIRECTORY_TYPE"
    ["$WORKSPACE_DIR/docker/LoonE/Dockerfile"]="$FILE_TYPE"
    ["$WORKSPACE_DIR/docker/Zedx/Dockerfile"]="$FILE_TYPE"
    ["$WORKSPACE_DIR/docker/compose.yaml"]="$FILE_TYPE"
)

#################################
# Dictionary to track variable status
# Globals:
# REQUIRED_VARIABLES
# NOT_CHECKED
# Format:
#   "variable"="status"
# Dictionary value types:
#   $MISSING | $INVALID | $VALID | $NOT_CHECKED
#################################
declare -A REQUIRED_VARIABLE_STATUS
init_status_map "$NOT_CHECKED" REQUIRED_VARIABLE_STATUS "${!REQUIRED_VARIABLES[@]}"

########################################
# Dictionary to track file structure status
# Globals:
#  CORRECT_FILE_STRUCTURE
#  NOT_CHECKED
# Format:
#   "path/to/file_or_directory"=status
# Dictionary value types:
#   $MISSING | $INVALID | $VALID | $NOT_CHECKED
#########################################
declare -A FILE_STRUCTURE_STATUS
init_status_map "$NOT_CHECKED" FILE_STRUCTURE_STATUS "${!CORRECT_FILE_STRUCTURE[@]}"

#######################################
# Required commands for LoonE to function
# Globals:
# NOT_CHECKED
# Format:
#   "command"=present?"
# Dictionary value types:
#  $VALID | $MISSING | $NOT_CHECKED
#########################################
declare -A required_commands
init_status_map "$NOT_CHECKED" required_commands "${required_commands_list[@]}"

#######################################
# Required apt packages for LoonE to function
# Globals:
# NOT_CHECKED
# Format:
#   "command"=present?"
# Dictionary value types:
#  $VALID | $MISSING | $NOT_CHECKED
#########################################
declare -A REQUIRED_APT_PACKAGES
init_status_map "$NOT_CHECKED" REQUIRED_APT_PACKAGES "${required_apt_packages_list[@]}"

